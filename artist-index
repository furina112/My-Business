<?php require 'music_dbconfig.php';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  $pdo->prepare("INSERT INTO artists (artist_name, genre) VALUES (?, ?)")
      ->execute([$_POST['artist_name'], $_POST['genre']]);
